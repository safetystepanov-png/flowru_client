class OperationIcon extends StatelessWidget {
  final String type;
  final bool negative;
  const OperationIcon({super.key, required this.type, required this.negative});

  @override
  Widget build(BuildContext context) {
    IconData icon = Icons.sync_alt_rounded;
    Color color = FlowColors.blue;
    if (type == 'visit') {
      icon = Icons.shopping_bag_rounded;
      color = FlowColors.blue;
    } else if (type.contains('spend') || type.contains('writeoff') || negative) {
      icon = Icons.remove_rounded;
      color = FlowColors.rose;
    } else if (type.contains('campaign')) {
      icon = Icons.campaign_rounded;
      color = FlowColors.violet;
    } else {
      icon = Icons.add_rounded;
      color = FlowColors.green;
    }
    return Container(width: 46, height: 46, decoration: BoxDecoration(color: color.withOpacity(0.10), borderRadius: BorderRadius.circular(16)), child: Icon(icon, color: color));
  }
}

